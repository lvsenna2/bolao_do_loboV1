  marginRange         String       @map("margin_range") @db.VarChar(40)
  submittedAt         DateTime     @default(now()) @map("submitted_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  entry             ElectionEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  winnerCandidate   ElectionCandidate @relation("ElectionPredictionWinner", fields: [winnerCandidateId], references: [id], onDelete: Restrict)
  runnerUpCandidate ElectionCandidate @relation("ElectionPredictionRunnerUp", fields: [runnerUpCandidateId], references: [id], onDelete: Restrict)

  @@index([winnerCandidateId])
  @@index([runnerUpCandidateId])
  @@index([submittedAt])
  @@map("election_predictions")
}

model ElectionResult {
  id                  String       @id @default(uuid()) @db.Uuid
  roundId             String       @unique @map("round_id") @db.Uuid
  winnerCandidateId   String       @map("winner_candidate_id") @db.Uuid
