model ElectionRound {
  id                   String              @id @default(uuid()) @db.Uuid
  createdById          String?             @map("created_by_id") @db.Uuid
  name                 String              @db.VarChar(140)
  description          String?
  rules                String?
  bannerUrl            String?             @map("banner_url")
  entryFee             Decimal             @default(10) @map("entry_fee") @db.Decimal(10, 2)
  registrationOpensAt  DateTime            @map("registration_opens_at")
  registrationClosesAt DateTime            @map("registration_closes_at")
  status               ElectionRoundStatus @default(DRAFT)
  finalPrize           Decimal?            @map("final_prize") @db.Decimal(10, 2)
  noWinnerDestination  String?             @map("no_winner_destination")
  finalizedAt          DateTime?           @map("finalized_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  createdBy  User?               @relation("ElectionRoundCreator", fields: [createdById], references: [id], onDelete: SetNull)
  candidates ElectionCandidate[]
  entries    ElectionEntry[]
  result     ElectionResult?
  winners    ElectionWinner[]
  audits     ElectionAuditLog[]

  @@index([status, registrationClosesAt])
  @@index([createdById])
  @@map("election_rounds")
}

model ElectionCandidate {
  id        String   @id @default(uuid()) @db.Uuid
  roundId   String   @map("round_id") @db.Uuid
  name      String   @db.VarChar(140)
  party     String   @db.VarChar(40)
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  round                 ElectionRound        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  predictionsAsWinner   ElectionPrediction[] @relation("ElectionPredictionWinner")
  predictionsAsRunnerUp ElectionPrediction[] @relation("ElectionPredictionRunnerUp")
  resultsAsWinner       ElectionResult[]     @relation("ElectionResultWinner")
  resultsAsRunnerUp     ElectionResult[]     @relation("ElectionResultRunnerUp")

  @@unique([roundId, name])
  @@index([roundId, active, sortOrder])
  @@map("election_candidates")
}

model ElectionEntry {
  id                   String         @id @default(uuid()) @db.Uuid
  roundId              String         @map("round_id") @db.Uuid
  userId               String         @map("user_id") @db.Uuid
  amount               Decimal        @db.Decimal(10, 2)
  paymentStatus        PaymentStatus  @default(PENDING) @map("payment_status")
  paymentGateway       PaymentGateway @default(MERCADO_PAGO) @map("payment_gateway")
  transactionId        String?        @unique @map("transaction_id")
  checkoutKey          String?        @unique @map("checkout_key") @db.VarChar(180)
  qrCode               String?        @map("qr_code")
  qrCodeBase64         String?        @map("qr_code_base64")
  ticketUrl            String?        @map("ticket_url")
  providerStatus       String?        @map("provider_status") @db.VarChar(80)
  providerStatusDetail String?        @map("provider_status_detail") @db.VarChar(120)
  paymentExpiresAt     DateTime?      @map("payment_expires_at")
  lastWebhookAt        DateTime?      @map("last_webhook_at")
  registeredAt         DateTime       @default(now()) @map("registered_at")
  confirmedAt          DateTime?      @map("confirmed_at")
  refundedAt           DateTime?      @map("refunded_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  round      ElectionRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  prediction ElectionPrediction?
  winner     ElectionWinner?

  @@unique([roundId, userId])
  @@index([userId])
  @@index([roundId, paymentStatus])
  @@map("election_entries")
}

model ElectionPrediction {
  id                  String       @id @default(uuid()) @db.Uuid
  entryId             String       @unique @map("entry_id") @db.Uuid
  winnerCandidateId   String       @map("winner_candidate_id") @db.Uuid
  runnerUpCandidateId String       @map("runner_up_candidate_id") @db.Uuid
